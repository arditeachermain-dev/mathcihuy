# Cloudflare Pages Deployment Ignore Rules (.cfignore)
# Prevent non-production scripts, SQL migrations, docs, backups, and private files from being served publicly.

.git/
.github/
.agents/
.wrangler/
node_modules/
scratch/
__pycache__/
Claude outputs/

