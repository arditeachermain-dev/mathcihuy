# ==============================================================================
# GLOBAL SECURITY HEADERS (Semua Path & Berkas di Math Cihuy)
# ==============================================================================
/*
  # Cegah MIME-type sniffing oleh browser
  X-Content-Type-Options: nosniff

  # Anti-Clickjacking: Melarang keras situs lain meng-embed portal ke dalam iframe
  X-Frame-Options: DENY

  # Referrer Policy: Kirim origin saja saat navigasi lintas domain aman
  Referrer-Policy: strict-origin-when-cross-origin

  # Strict-Transport-Security (HSTS): Wajibkan enkripsi HTTPS penuh selama 1 tahun
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload

  # Batasi akses fitur perangkat keras browser yang tidak diperlukan
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()

  # Perlindungan Cross-Origin & XSS Filter
  X-XSS-Protection: 1; mode=block
  Cross-Origin-Opener-Policy: same-origin-allow-popups

  # Content-Security-Policy (CSP) Kuat & Kompatibel Penuh:
  # - Izinkan aset internal portal ('self')
  # - Izinkan API Supabase Cloud (HTTPS & WebSocket Realtime)
  # - Izinkan CDN resmi jsdelivr untuk Supabase SDK & pustaka pendukung
  # - Izinkan webhook fallback Google Apps Script
  # - Blokir penyematan iframe dari luar (frame-ancestors 'none')
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net; font-src 'self' data: https://cdn.jsdelivr.net; img-src 'self' data: blob: https:; connect-src 'self' https://pecvxqguqtancizghnhj.supabase.co wss://pecvxqguqtancizghnhj.supabase.co https://script.google.com https://script.googleusercontent.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self';

