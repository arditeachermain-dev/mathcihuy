# index.html: always revalidate so a redeploy reaches students immediately,
# but allow a 304 instead of re-downloading the whole file on every page view.
/index.html
  Cache-Control: no-cache
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

/
  Cache-Control: no-cache

# ikon dan manifest jarang berubah
/icon-*.png
  Cache-Control: public, max-age=604800

/manifest.json
  Cache-Control: public, max-age=86400

# service worker harus selalu diperiksa ulang, kalau tidak pembaruan portal
# tidak akan pernah sampai ke perangkat yang sudah memasangnya
/sw.js
  Cache-Control: no-cache
  Service-Worker-Allowed: /
